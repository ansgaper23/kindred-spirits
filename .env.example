# Copy the values already committed in .env (Supabase project — public/publishable
# keys, safe to expose to the browser) and set these SERVER-ONLY secrets
# alongside them wherever this app is actually deployed (Lovable Cloud /
# hosting provider env vars). Never prefix these with VITE_ — that would ship
# them to the browser bundle.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-pro if unset.
GEMINI_MODEL=

# Only needed if you add server-side admin operations that must bypass RLS
# (src/integrations/supabase/client.server.ts). Get it from
# Supabase Dashboard -> Project Settings -> API -> service_role key.
# Treat it as a full-access database password — never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
